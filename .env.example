# Optional public HTTPS origin/base URL for the conversion API, included at build time.
# Reserved for future automatic conversion integration; current UI imports PDFs only.
VITE_CONVERSION_SERVER=
# Server only: extra web origins, comma separated. Native origins are already allowed.
FOLIO_ALLOWED_ORIGINS=
# Public, non-secret backend origin for native app builds; HTTPS only. Never put a key here.
VITE_FOLIO_BACKEND_URL=
