{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:office": "node scripts/setup-office.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:run": "npm run mobile:sync && npx cap run android",
    "android:build": "npm run mobile:sync && node scripts/build-android.mjs",
    "ios:open": "npx cap open ios",
    "ios:run": "npm run mobile:sync && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "concurrently": "^10.0.5",
    "core-js": "^3.50.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0"
  }
}
