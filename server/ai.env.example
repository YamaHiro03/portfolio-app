# Copy to .private/ai.env (chmod 600); do not put this file into Vite environment files.
FOLIO_AI_GATEWAY_URL=http://127.0.0.1:8317/v1
FOLIO_AI_GATEWAY_KEY=
FOLIO_AI_MODEL=gpt-6-luna
# Generate a separate >=24-character random demo login code, never the Gateway key.
FOLIO_AI_DEMO_PASSWORD=
# Local development only; ignored when NODE_ENV=production.
FOLIO_AI_ALLOW_LOCAL_HTTP=true
# Off until the existing published test key has actually been rotated.
FOLIO_AI_REMOTE_ENABLED=false
FOLIO_AI_KEY_ROTATED=false
FOLIO_AI_PUBLIC_ORIGIN=
FOLIO_AI_TRUST_LOCAL_PROXY=false
